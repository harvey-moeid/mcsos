{
  "name": "social-mcp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --include-runtime false --strict-vars false",
    "test": "vitest run tests",
    "check": "npm run typecheck && npm test && vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview --host 0.0.0.0",
    "setup:local": "node scripts/setup-local.mjs",
    "check:runtime": "npm run build && wrangler deploy --dry-run --outdir work/worker-build && node scripts/smoke-runtime.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "test:ui": "playwright test",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": ">=24"
  }
}
