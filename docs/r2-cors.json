{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://social-mcp.harveymoeid.workers.dev"
        ],
        "methods": [
          "PUT"
        ],
        "headers": [
          "content-type",
          "x-amz-checksum-crc32",
          "x-amz-sdk-checksum-algorithm"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
