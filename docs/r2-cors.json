{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://sosial-mcp.muidsoft.com"
        ],
        "methods": [
          "PUT"
        ],
        "headers": [
          "content-type",
          "x-amz-checksum-crc32",
          "x-amz-sdk-checksum-algorithm"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
